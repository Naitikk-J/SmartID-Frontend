{
    "rewrites": [
        {
            "source": "/api/:path*",
            "destination": "https://smart-id-backend.vercel.app/api/:path*"
        },
        {
            "source": "/socket.io/:path*",
            "destination": "https://smart-id-backend.vercel.app/socket.io/:path*"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}
